# Public project credentials used by @supabase/ssr in browser and server clients
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Canonical application origin. No path and no trailing slash. HTTPS in production.
APP_ORIGIN=http://localhost:3000

# Server-only project URL or PostgreSQL connection URL from Supabase -> Connect
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Only this verified Supabase Auth user may access the admin area in production
ADMIN_EMAIL=werner@example.com
PRIVACY_CONTACT_EMAIL=datenschutz@example.com

# At least 32 random bytes, used only to pseudonymise rate-limit keys.
RATE_LIMIT_SECRET=replace-with-a-long-random-secret

# Set only behind a proxy that removes incoming copies of this header.
# Vercel is detected automatically through x-vercel-forwarded-for.
# TRUSTED_PROXY_HEADER=x-forwarded-for

# Optional: direct PostgreSQL setup through the IPv4 pooler
SUPABASE_POOLER_HOST=aws-1-your-region.pooler.supabase.com

# Optional: result e-mails through Resend
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="AlphaQuiz <ergebnisse@quiz.example.com>"
