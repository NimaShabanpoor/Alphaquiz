# PostgreSQL-Verbindungsadresse aus Supabase → Connect
SUPABASE_URL=postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_POOLER_HOST=aws-1-your-region.pooler.supabase.com

# Optional: Ergebnis-E-Mails über Resend
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="AlphaQuiz <ergebnisse@quiz.example.com>"
ADMIN_RESULT_EMAIL=admin@example.com
